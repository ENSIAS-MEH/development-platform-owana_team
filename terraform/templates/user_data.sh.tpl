#!/bin/bash
# =============================================================================
# FoundersSync — EC2 Bootstrap Script
# Generated by Terraform — runs once on first boot as root
# =============================================================================
set -euo pipefail
exec > >(tee /var/log/founderssync-bootstrap.log | logger -t founderssync-bootstrap -s 2>/dev/console) 2>&1

echo "================================================================"
echo " FoundersSync Bootstrap — $(date)"
echo "================================================================"

# ─── 1. System update ────────────────────────────────────────────────────────
echo "[1/8] Updating system packages..."
dnf update -y --allowerasing || dnf update -y --skip-broken || true
dnf install -y git curl unzip tar --allowerasing || true

# ─── 2. Install Docker ───────────────────────────────────────────────────────
echo "[2/8] Installing Docker..."
dnf install -y docker
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

# Docker Compose v2 plugin
echo "[3/8] Installing Docker Compose v2..."
DOCKER_COMPOSE_VERSION="2.27.1"
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v$${DOCKER_COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
ln -sf /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose

docker --version
docker compose version

# ─── 3. Install Java 21 (for optional local Maven builds) ────────────────────
echo "[4/8] Installing Java 21..."
dnf install -y java-21-amazon-corretto-headless
java -version

# ─── 4. Create app directory ─────────────────────────────────────────────────
echo "[5/8] Setting up application directory..."
APP_DIR="/opt/founderssync"
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"

# ─── 5. Write .env file ──────────────────────────────────────────────────────
echo "[6/8] Writing environment file..."
#
# NOTE on the quoted heredoc delimiter <<'ENVEOF':
#
# Terraform's templatefile() processes this entire script FIRST and substitutes
# all $${var_name} placeholders with their real values before the script ever
# runs on the EC2 instance. By the time bash executes the heredoc, the values
# are already literals in the file — there are no shell variables left to expand.
#
# The single-quoted delimiter <<'ENVEOF' suppresses bash's own variable
# expansion inside the heredoc body. This prevents bash from trying to expand
# things like ${cors_allowed_origins} or ${rds_endpoint} a second time, which
# would fail because those names are not bash variables — they are Terraform
# template tokens that have already been replaced.
#
# Execution order:
#   1. terraform apply  →  templatefile() substitutes ${db_password}, etc.
#   2. Rendered script is uploaded to EC2 as user_data
#   3. EC2 first boot  →  bash runs the script; heredoc writes literal values
#
cat > "$APP_DIR/.env" <<'ENVEOF'
# ─── Database ─────────────────────────────────────────────────────────────────
DB_USERNAME=${db_username}
DB_PASSWORD=${db_password}
DB_HOST=${rds_endpoint}
DB_PORT=5432

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=${jwt_secret}

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=${mail_username}
MAIL_PASSWORD=${mail_password}

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_USERNAME=${admin_email}
ADMIN_PASSWORD=${admin_password}

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY=${aws_access_key_app}
AWS_SECRET_KEY=${aws_secret_key_app}
AWS_BUCKET_NAME=${aws_s3_bucket_name}
AWS_REGION=${aws_region}

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=${frontend_url}
CORS_ALLOWED_ORIGINS=${cors_allowed_origins}
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ─── Spring Cloud Config Server ───────────────────────────────────────────────
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_REPO_PATH=file:/opt/founderssync/config-repo

# ─── Service URLs (Docker container names) ────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
STARTUP_SERVICE_URL=http://startup-service:8083
POST_SERVICE_URL=http://post-service:8084
CHAT_SERVICE_URL=http://chat-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
ENVEOF

chmod 600 "$APP_DIR/.env"
chown ec2-user:ec2-user "$APP_DIR/.env"
echo "  .env written to $APP_DIR/.env"

# ─── 6. Clone backend repository ─────────────────────────────────────────────
echo "[7/8] Cloning FoundersSync backend..."
if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u ec2-user git clone https://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@github.com/ENSIAS-MEH/development-platform-owana_team.git "$APP_DIR/repo"
  cp -r "$APP_DIR/repo/." "$APP_DIR/"
  rm -rf "$APP_DIR/repo"
else
  echo "  Repo already cloned — pulling latest..."
  sudo -u ec2-user git -C "$APP_DIR" pull --ff-only
fi

# ─── 7. Wait for Docker + start the stack ────────────────────────────────────
echo "[8/8] Starting FoundersSync stack with Docker Compose..."
# Give Docker a moment after usermod
sleep 5

# Run as ec2-user so the docker group permission applies
sudo -u ec2-user bash -c "
  cd '$APP_DIR'
  docker compose pull 2>/dev/null || true
  docker compose up -d --build 2>&1 | tee /var/log/founderssync-compose.log
"

echo ""
echo "================================================================"
echo " Bootstrap complete — $(date)"
echo " App directory : $APP_DIR"
echo " Logs          : /var/log/founderssync-bootstrap.log"
echo "                 /var/log/founderssync-compose.log"
echo " API Gateway   : http://$(curl -s http://169.254.169.254/latest/meta-data/public-ipv4):8080"
echo "================================================================"
