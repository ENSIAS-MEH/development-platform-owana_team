# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files
tfplan
*.tfplan

# Sensitive variable values — never commit
terraform.tfvars

# Local Terraform directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
